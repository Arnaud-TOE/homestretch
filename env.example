# PayPal sandbox credentials, from developer.paypal.com. The app needs Payouts enabled.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# The sandbox personal account that receives every demo payment, because the crew is fictional.
PAYOUT_SANDBOX_RECEIVER=

# The assistant. With no key, the schedule and payments still work, and the assistant says it isn't set up.
OPENAI_API_KEY=

# Optional: a free Bryntum trial key, from bryntum.com/download. It covers every visitor for 45 days from
# the day you register. Without one, each browser gets 14 days from its first visit.
# NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=

# Optional: another model for the assistant.
# OPENAI_MODEL=gpt-5.4-mini

# Optional: limits for a public demo (lib/guard.ts). One question usually takes several model calls.
# AI_CALLS_PER_VISITOR=40
# AI_CALLS_PER_DAY=80
# Reasoning effort sent to the model. With tools on Chat Completions, gpt-5.4-mini only takes 'none' (the default).
# OPENAI_REASONING_EFFORT=none
# PAYOUT_DOLLARS_PER_DAY=2500
